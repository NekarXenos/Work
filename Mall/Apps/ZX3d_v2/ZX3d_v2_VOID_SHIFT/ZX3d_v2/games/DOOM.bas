10 REM SPECTRUM DOOM - THREE SHIFTS AT THE VOID STATION
20 REM SCREEN 4 GAMEPLAY IS WRITTEN IN BASIC
30 REM WASD MOVE - MOUSE AIM - CLICK/SPACE FIRE - E USE
40 REM CLEAR THE HOSTILES, THEN USE THE GREEN EAST LIFT
50 REM THE LIFT WRAPS EAST TO WEST AND CHANGES THE MAP
60 SCREEN 4: POKE 64000,1: POKE 64025,1
70 DIM m(11,11): DIM ex(6): DIM ez(6): DIM eh(6): DIM ec(6)
80 DIM dx(2): DIM dz(2): DIM ds(2)
90 DIM px(4): DIM pz(4): DIM pt(4): DIM ps(4)
100 LET le=1: LET hp=100: LET am=40: LET kills=0: LET t=0: LET cd=0
110 GOSUB 4000: GOSUB 1000
120 GO TO 500
500 REM TEN HZ GAME LOOP; INPUT AND AIM ARE HOST SNAPSHOTS
510 LET t=t+1: LET warp=0
520 IF cd>0 THEN LET cd=cd-1
530 LET playerx=PEEK 64001: LET playerz=PEEK 64003
540 LET fire=PEEK 64013
550 IF fire=1 THEN GOSUB 2000
560 LET use=PEEK 64014
570 IF use=1 THEN GOSUB 2500
580 IF warp=1 THEN GO TO 500
590 IF PEEK 64000=4 THEN GO TO 820
600 FOR p=1 TO 4
610 IF ps(p)=0 AND (playerx-px(p))^2+(playerz-pz(p))^2<121 THEN GOSUB 2800
620 NEXT p
630 IF t-2*INT (t/2)=0 THEN GOSUB 3000
640 IF hp<=0 THEN LET hp=0: GOSUB 900: POKE 64025,11: POKE 64000,3: GO TO 820
650 IF mt>0 THEN LET mt=mt-1
660 IF mt=0 THEN LET status=0
670 IF mt=0 AND ABS (playerx-207)<16 AND ABS (playerz-127)<16 THEN LET status=13
680 GOSUB 900
690 PAUSE 5
700 GO TO 500
820 REM HOST SHOWS THE RESULT AND RESTART BUTTON
830 PAUSE 50: GO TO 830
900 REM HEALTH, AMMO, LEVEL, TOTAL KILLS, CURRENT HOSTILES
910 POKE 64020,hp: POKE 64021,am: POKE 64022,le
920 POKE 64023,kills: POKE 64024,alive: POKE 64025,status
930 RETURN
1000 REM BUILD A DIFFERENT MAP WITHOUT RESETTING HEALTH OR AMMO
1010 POKE 64000,1: POKE 64025,1: POKE 64022,le
1020 FOR n=1 TO 6: UNPUT n: NEXT n
1030 FOR n=20 TO 23: UNPUT n: NEXT n
1040 UNPUT 30: UNPUT 31
1050 SCREEN 4: CLS: MAT 0: OVER 0: BRIGHT 0
1060 INK 8: CUBE 17,0,17,220,1,220: CUBE 17,28,17,220,2,220
1070 RESTORE 6000+(le-1)*200
1080 LET doors=0
1090 FOR row=1 TO 11
1100 READ row$
1110 FOR col=1 TO 11
1120 LET tile=VAL row$(col): LET m(col,row)=tile
1130 LET wx=17+(col-1)*20: LET wz=17+(row-1)*20
1135 IF tile=0 THEN INK le*(col+row-2*INT ((col+row)/2)): CUBE wx,0,wz,20,1,20: INK 7: CUBE wx,0,wz,20,1,1: CUBE wx,0,wz,1,1,20
1140 IF tile=1 THEN INK le: CUBE wx,1,wz,20,27,20: INK 7: CUBE wx,1,wz,20,2,20: CUBE wx,25,wz,20,3,20
1150 IF tile=2 THEN LET doors=doors+1: LET dx(doors)=col: LET dz(doors)=row: LET ds(doors)=0: MAT 0: PUT 29+doors,wx,1,wz
1160 NEXT col
1170 NEXT row
1180 REM GLOW STRIPS IN OPEN ROOMS AND TWO EDGE LIFT LANDINGS
1190 MAT 2: INK 9+le
1200 FOR col=2 TO 10
1210 IF m(col,2)=0 THEN CUBE 24+(col-1)*20,26,43,6,1,2
1220 IF m(col,10)=0 THEN CUBE 24+(col-1)*20,26,207,6,1,2
1230 NEXT col
1240 INK 13: CUBE 42,0,122,11,1,11
1250 INK 12: CUBE 202,0,122,11,1,11: CUBE 216,6,119,1,16,16
1260 INK 15: CUBE 215,12,122,1,2,10: CUBE 215,9,130,1,8,2
1270 REM SIX HOSTILES, TWO AMMO CRATES, TWO MEDKITS
1280 LET alive=6
1290 FOR i=1 TO 6
1300 READ col,row
1310 LET ex(i)=27+(col-1)*20: LET ez(i)=27+(row-1)*20
1320 LET eh(i)=2+INT (le/2): LET ec(i)=10+i
1330 MAT 2: PUT i,ex(i)-3,1,ez(i)-2,0
1340 NEXT i
1350 FOR p=1 TO 4
1360 READ col,row,kind
1370 LET px(p)=27+(col-1)*20: LET pz(p)=27+(row-1)*20
1380 LET pt(p)=kind: LET ps(p)=0
1390 MAT 2: PUT 19+p,px(p)-3,1,pz(p)-3
1400 NEXT p
1410 MAT 0: LET cd=0: LET status=10: LET mt=30
1420 VIEW 47,1,127: POKE 64028,192
1430 GOSUB 900: POKE 64000,2
1440 RETURN
2000 REM HITS ONLY COUNT ON THE FIRST VOXEL HIT BY THE AIM RAY
2010 IF cd>0 THEN LET status=14: LET mt=5: RETURN
2020 IF am=0 THEN LET status=9: LET mt=18: BEEP .04,-20: RETURN
2030 LET am=am-1: LET cd=3: POKE 64026,1: BEEP .025,-8
2040 LET hit=PEEK 64008: LET hx=PEEK 64005: LET hy=PEEK 64006: LET hz=PEEK 64007
2050 IF hit=0 THEN RETURN
2060 LET target=0
2070 FOR i=1 TO 6
2080 IF eh(i)>0 AND hx>=ex(i)-3 AND hx<=ex(i)+3 AND hy>=1 AND hy<=19 AND hz>=ez(i)-2 AND hz<=ez(i)+2 THEN LET target=i
2090 NEXT i
2100 IF target=0 THEN RETURN
2110 LET eh(target)=eh(target)-1: LET status=7: LET mt=8
2120 IF eh(target)>0 THEN MAT 2: MOVE target,ex(target)-3,1,ez(target)-2,1: MAT 0: RETURN
2130 UNPUT target: LET kills=kills+1: LET alive=alive-1
2140 LET am=am+2: IF am>99 THEN LET am=99
2150 LET status=8: LET mt=14: BEEP .05,6
2160 RETURN
2500 REM E OPENS A YELLOW DOOR OR ACTIVATES THE EAST LIFT
2510 LET status=2: LET mt=12
2520 FOR d=1 TO 2
2530 IF ds(d)=0 AND ABS (playerx-(27+(dx(d)-1)*20))<24 AND ABS (playerz-(27+(dz(d)-1)*20))<24 THEN UNPUT 29+d: LET ds(d)=1: LET m(dx(d),dz(d))=0: LET status=4: LET mt=18: BEEP .06,2
2540 NEXT d
2550 IF ABS (playerx-207)>=15 OR ABS (playerz-127)>=15 THEN RETURN
2560 IF alive>0 THEN LET status=3: LET mt=25: BEEP .06,-15: RETURN
2570 IF le=3 THEN LET status=12: GOSUB 900: POKE 64000,4: RETURN
2580 LET le=le+1: LET warp=1: BEEP .12,12: GOSUB 1000
2590 RETURN
2800 REM WALK OVER SUPPLIES TO COLLECT; MEDKITS NEVER EXCEED 100
2810 IF pt(p)=2 AND hp=100 THEN RETURN
2820 IF pt(p)=1 AND am=99 THEN RETURN
2830 UNPUT 19+p: LET ps(p)=1: LET mt=18
2840 IF pt(p)=1 THEN LET am=am+16: LET status=5
2850 IF pt(p)=2 THEN LET hp=hp+30: LET status=6
2860 IF am>99 THEN LET am=99
2870 IF hp>100 THEN LET hp=100
2880 BEEP .04,12: RETURN
3000 REM ENEMIES SEE, CHASE AND ATTACK IN BASIC EVERY OTHER TICK
3010 FOR i=1 TO 6
3020 IF eh(i)>0 THEN GOSUB 3100
3030 NEXT i
3040 MAT 0: RETURN
3100 IF ec(i)>0 THEN LET ec(i)=ec(i)-1
3110 LET dist=SQR ((playerx-ex(i))^2+(playerz-ez(i))^2)
3120 IF dist>72 THEN RETURN
3130 REM SAMPLE THE ACTUAL WORLD SO WALLS AND DOORS BLOCK SIGHT
3140 LET visible=1
3150 FOR q=8 TO dist-6 STEP 6
3160 LET rx=ex(i)+(playerx-ex(i))*q/dist: LET rz=ez(i)+(playerz-ez(i))*q/dist
3170 IF POINT (rx,14,rz)>=0 THEN LET visible=0
3180 NEXT q
3190 IF visible=0 THEN RETURN
3200 IF dist<21 AND ec(i)=0 THEN LET hp=hp-6-2*le: LET ec(i)=6: POKE 64027,1: LET status=15: LET mt=10: RETURN
3210 IF dist<11 THEN RETURN
3220 LET nx=ex(i)+2*SGN (playerx-ex(i)): LET nz=ez(i)+2*SGN (playerz-ez(i)): GOSUB 3400
3230 IF ok=0 THEN LET nx=ex(i)+2*SGN (playerx-ex(i)): LET nz=ez(i): GOSUB 3400
3240 IF ok=0 THEN LET nx=ex(i): LET nz=ez(i)+2*SGN (playerz-ez(i)): GOSUB 3400
3250 IF ok=0 THEN RETURN
3260 LET frame=INT (t/2)-2*INT (t/4)
3270 MAT 2: MOVE i,nx-3,1,nz-2,frame
3280 LET ex(i)=nx: LET ez(i)=nz
3290 RETURN
3400 REM SPRITES NEVER OVERLAP: SAVED BACKGROUNDS STAY VALID
3410 LET ok=1
3420 FOR a=-1 TO 1 STEP 2: FOR b=-1 TO 1 STEP 2
3430 LET cc=INT ((nx+4*a-17)/20)+1: LET rr=INT ((nz+3*b-17)/20)+1
3440 IF cc<1 OR cc>11 OR rr<1 OR rr>11 THEN LET ok=0
3450 IF cc>=1 AND cc<=11 AND rr>=1 AND rr<=11 THEN IF m(cc,rr)<>0 THEN LET ok=0
3460 NEXT b: NEXT a
3470 IF (nx-playerx)^2+(nz-playerz)^2<100 THEN LET ok=0
3480 FOR j=1 TO 6
3490 IF j<>i AND eh(j)>0 AND (nx-ex(j))^2+(nz-ez(j))^2<196 THEN LET ok=0
3500 NEXT j
3510 FOR j=1 TO 4
3520 IF ps(j)=0 AND (nx-px(j))^2+(nz-pz(j))^2<121 THEN LET ok=0
3530 NEXT j
3540 RETURN
4000 REM TWO-FRAME RED VOXEL SENTRIES: SEPARATE INSTANCES
4010 FOR n=1 TO 6
4020 SPRITE n,7,19,5,2
4030 FOR layer=0 TO 4: FOR f=0 TO 1
4040 SDATA n,f,0,"..AAA..",layer
4050 SDATA n,f,1,".AAAAA.",layer
4060 SDATA n,f,2,".AFAFA.",layer
4070 SDATA n,f,3,".AA0AA.",layer
4080 SDATA n,f,4,"..AAA..",layer
4090 SDATA n,f,5,".22222.",layer
4100 SDATA n,f,6,"2222222",layer
4110 SDATA n,f,7,"A22222A",layer
4120 SDATA n,f,8,"A22E22A",layer
4130 SDATA n,f,9,"A22222A",layer
4140 SDATA n,f,10,"A22222A",layer
4150 SDATA n,f,11,"A22222A",layer
4160 SDATA n,f,12,".22222.",layer
4170 SDATA n,f,13,".22222.",layer
4180 SDATA n,f,14,".22.22.",layer
4190 SDATA n,f,15,".22.22.",layer
4200 SDATA n,f,16,".22.22.",layer
4210 SDATA n,f,17,".22.22.",layer
4220 SDATA n,f,18,".88.88.",layer
4230 IF f=1 THEN SDATA n,f,16,"22...22",layer: SDATA n,f,17,"22...22",layer: SDATA n,f,18,"88...88",layer
4240 NEXT f: NEXT layer: NEXT n
4250 REM GLOWING AMMO (YELLOW) AND MEDKITS (WHITE/RED CROSS)
4260 FOR n=20 TO 23
4270 SPRITE n,7,5,7,1
4280 FOR layer=0 TO 6
4290 SDATA n,0,0,".EEEEE.",layer: SDATA n,0,1,"EEEEEEE",layer
4300 SDATA n,0,2,"E88888E",layer: SDATA n,0,3,"EEEEEEE",layer: SDATA n,0,4,".EEEEE.",layer
4310 IF n>=22 THEN SDATA n,0,0,".FFAFF.",layer: SDATA n,0,1,"FFFAFFF",layer: SDATA n,0,2,"FAAAAAF",layer: SDATA n,0,3,"FFFAFFF",layer: SDATA n,0,4,".FFAFF.",layer
4320 NEXT layer: NEXT n
4330 REM SOLID DOOR SPRITES RESTORE EMPTY AIR WHEN OPENED
4340 FOR n=30 TO 31
4350 SPRITE n,20,27,20,1
4360 FOR layer=0 TO 19: FOR row=0 TO 26
4370 SDATA n,0,row,"66666666666666666666",layer
4380 IF row=0 OR row=26 THEN SDATA n,0,row,"77777777777777777777",layer
4390 IF row=12 OR row=13 THEN SDATA n,0,row,"EEEEEEEEEEEEEEEEEEEE",layer
4400 NEXT row: NEXT layer: NEXT n
4410 RETURN
